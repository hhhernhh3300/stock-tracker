# Keep the Docker build context small and reproducible.

# Python
**/__pycache__/
**/*.pyc
**/venv/
**/.venv/
backend/.env

# Node / frontend build artifacts (rebuilt inside the image)
**/node_modules/
frontend/dist/

# Editors / OS
.vscode/
.idea/
**/.DS_Store

# VCS
.git/
.gitignore

# Docs not needed at runtime
*.md
