# Production build config for the frontend.
# Copy to ".env.production" (git-ignored via frontend/.env) OR set this variable
# directly in your host's dashboard (Render/Vercel/Netlify) — that is preferred.
#
# Point the built site at your PUBLIC backend URL (https), e.g. the Render API URL.
VITE_API_URL=https://analyst-agent-api.onrender.com
