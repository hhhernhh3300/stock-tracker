# Copy this file to ".env" and fill in ONE LLM provider key (or none — see below).
# The app works WITHOUT any LLM key: it falls back to the free, deterministic
# rule-based engine (rules.py). Add a key only to upgrade to AI-written reasoning.

# --- Choose your LLM provider -------------------------------------------------
# anthropic | openai | gemini | openai_compatible | auto
#   auto = use the first provider below whose API key is set
#          (order: anthropic, openai, gemini, openai_compatible).
#   Set explicitly if you have more than one key configured.
LLM_PROVIDER=auto

# --- Provider API keys (set ONE; the rest can stay blank) ---------------------
# Anthropic Claude  -> https://console.anthropic.com/settings/keys   (paid)
ANTHROPIC_API_KEY=
# OpenAI GPT        -> https://platform.openai.com/api-keys          (paid)
OPENAI_API_KEY=
# Google Gemini     -> https://aistudio.google.com/app/apikey        (FREE tier!)
GEMINI_API_KEY=

# --- OpenAI-COMPATIBLE gateway (FREE options: Groq, OpenRouter, Mistral, ...) --
# One code path covers many providers that speak the OpenAI API. Set all three:
#   LLM_PROVIDER=openai_compatible
#   OPENAI_COMPAT_API_KEY=<your key>
#   OPENAI_COMPAT_BASE_URL=<the provider's /v1 URL>
#   OPENAI_COMPAT_MODEL=<a model id that provider exposes>
#
# Free-tier examples (create your OWN key — never commit it):
#   Groq        keys: https://console.groq.com/keys
#               BASE_URL=https://api.groq.com/openai/v1
#               MODEL=llama-3.3-70b-versatile
#   OpenRouter  keys: https://openrouter.ai/keys   (use a ":free" model)
#               BASE_URL=https://openrouter.ai/api/v1
#               MODEL=meta-llama/llama-3.3-70b-instruct:free
#   Mistral     keys: https://console.mistral.ai
#               BASE_URL=https://api.mistral.ai/v1
#               MODEL=mistral-small-latest
#   Cerebras    keys: https://cloud.cerebras.ai
#               BASE_URL=https://api.cerebras.ai/v1
#               MODEL=llama-3.3-70b
#   (A LiteLLM / corporate gateway works too — point BASE_URL at its /v1 endpoint
#    and use a key you are AUTHORIZED to use.)
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_MODEL=

# --- Optional: override the default model per provider -------------------------
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# OPENAI_MODEL=gpt-4o-2024-11-20
# GEMINI_MODEL=gemini-1.5-flash

# --- Behaviour ----------------------------------------------------------------
# If true (default), fall back to the free rule-based engine when no LLM key is
# set OR an LLM call fails. Set to false to require a working LLM call.
ALLOW_RULES_FALLBACK=true

# --- Market data --------------------------------------------------------------
# Optional — Alpha Vantage key used only as a fallback quote source if Yahoo is
# missing a live price (https://www.alphavantage.co/support/#api-key)
ALPHAVANTAGE_API_KEY=

# Price/history source: yahoo (default) | ibkr | auto
#   yahoo = always Yahoo Finance
#   ibkr  = always IBKR (requires the Client Portal Gateway running + logged in)
#   auto  = IBKR when its gateway is authenticated, otherwise Yahoo
DATA_SOURCE=yahoo
# IBKR Client Portal Gateway base URL (only used when DATA_SOURCE=ibkr or auto)
IBKR_BASE_URL=https://localhost:5000/v1/api

# --- CORS (production) --------------------------------------------------------
# Comma-separated list of allowed frontend origins. Default "*" for local dev.
# CORS_ORIGINS=https://your-frontend.example.com
